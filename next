apple_pwd = st.sidebar.text_input("Password", type="password", value=st.session_state.get("apple_pwd", ""))

if st.sidebar.button("Connect & Start Logger"):
    if apple_id and apple_pwd:
        try:
            api = PyiCloudService(apple_id, apple_pwd, cookie_directory=COOKIE_DIR)
            st.session_state.api = api
            st.session_state.apple_id = apple_id
            st.session_state.apple_pwd = apple_pwd
            
            if api.requires_2fa:
                st.session_state.needs_2fa = True
            else:
                st.session_state.logged_in = True
                st.session_state.needs_2fa = False
                st.sidebar.success("Successfully Authenticated!")
        except Exception as e:
            st.sidebar.error(f"Login failed: {e}")

if st.session_state.get("needs_2fa", False):
    st.sidebar.warning("Two-Factor Authentication Required")
    code_2fa = st.sidebar.text_input("Enter 6-Digit 2FA Code")
    if st.sidebar.button("Verify Code"):
        if st.session_state.api.validate_2fa_code(code_2fa):
            st.session_state.logged_in = True
            st.session_state.needs_2fa = False
            st.sidebar.success("2FA Verified!")
            st.rerun()
        else:
            st.sidebar.error("Invalid 2FA Code")

# Start background thread if authenticated
if st.session_state.logged_in:
    if "thread_started" not in st.session_state:
        logger_thread = threading.Thread(
            target=run_logger_loop, 
            args=(st.session_state.apple_id, st.session_state.apple_pwd), 
            daemon=True
        )
        logger_thread.start()
        st.session_state.thread_started = True

    if THREAD_STATUS["active"]:
        st.sidebar.info("🟢 Background Logger Active")
    elif THREAD_STATUS["error"]:
        st.sidebar.error(f"🔴 {THREAD_STATUS['error']}")

