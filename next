# ==========================================
# HELPER FUNCTIONS: MATH & GPS CLEANING
# ==========================================
def haversine_meters(lat1, lon1, lat2, lon2):
    """Calculates distance in meters between two coordinates."""
    R = 6371000.0  # Earth radius in meters
    dlat = math.radians(lat2 - lat1)
    dlon = math.radians(lon2 - lon1)
    a = (math.sin(dlat / 2) ** 2 + 
         math.cos(math.radians(lat1)) * math.cos(math.radians(lat2)) * math.sin(dlon / 2) ** 2)
    return R * 2 * math.atan2(math.sqrt(a), math.sqrt(1 - a))

def clean_gps_data(df: pd.DataFrame, max_accuracy_m=50.0, min_move_m=10.0, max_speed_kmh=160.0) -> pd.DataFrame:
    """Filters out low accuracy readings, stationary GPS drift, and teleportation spikes."""
    if df.empty or len(df) < 2:
        return df

    clean_df = df[df["accuracy"] <= max_accuracy_m].copy()
    clean_df = clean_df.sort_values("timestamp").reset_index(drop=True)

    if len(clean_df) < 2:
        return clean_df

    valid_indices = [0]

    for i in range(1, len(clean_df)):
        last_idx = valid_indices[-1]
        
        lat1, lon1 = clean_df.loc[last_idx, ["latitude", "longitude"]]
        lat2, lon2 = clean_df.loc[i, ["latitude", "longitude"]]
        t1, t2 = clean_df.loc[last_idx, "timestamp"], clean_df.loc[i, "timestamp"]

        dist_m = haversine_meters(lat1, lon1, lat2, lon2)
        dt_sec = (t2 - t1).total_seconds()
        speed_kmh = ((dist_m / 1000.0) / (dt_sec / 3600.0)) if dt_sec > 0 else 0.0

        if dist_m >= min_move_m and speed_kmh <= max_speed_kmh:
            valid_indices.append(i)

    return clean_df.iloc[valid_indices].reset_index(drop=True)

def calculate_trip_stats(df: pd.DataFrame):
    """Calculates total distance, duration, and average speed."""
    if len(df) < 2:
        return {
            "dist_km": 0.0, "dist_mi": 0.0,
            "duration_hrs": 0.0, "duration_min": 0,
            "avg_speed_kmh": 0.0, "avg_speed_mph": 0.0
        }

    total_dist_km = 0.0
    coords = df[["latitude", "longitude"]].values

    for i in range(1, len(coords)):
        lat1, lon1 = coords[i-1]
        lat2, lon2 = coords[i]
        total_dist_km += haversine_meters(lat1, lon1, lat2, lon2) / 1000.0

    time_delta = df["timestamp"].max() - df["timestamp"].min()
    duration_hrs = time_delta.total_seconds() / 3600.0
    duration_min = int(time_delta.total_seconds() / 60)
    avg_speed_kmh = (total_dist_km / duration_hrs) if duration_hrs > 0 else 0.0

    return {
        "dist_km": total_dist_km,
        "dist_mi": total_dist_km * 0.621371,
        "duration_hrs": duration_hrs,
        "duration_min": duration_min,
        "avg_speed_kmh": avg_speed_kmh,
        "avg_speed_mph": avg_speed_kmh * 0.621371
    }

# ==========================================
# BACKGROUND LOGGER THREAD WORKER
# ==========================================
def run_logger_loop(apple_id, password):
    """Background worker that continuously polls location and rotates CSVs hourly."""
    global THREAD_STATUS
    THREAD_STATUS["active"] = True
    THREAD_STATUS["error"] = None
    
    try:
        api = PyiCloudService(apple_id, password, cookie_directory=COOKIE_DIR)
        
        while True:
            # Check if session expired
            if api.requires_2fa:
                THREAD_STATUS["active"] = False
                THREAD_STATUS["error"] = "Session expired (2FA required). Re-authenticate in the sidebar."
                break

            now = datetime.now()
            filename = f"locations_{now.strftime('%Y-%m-%d_%H00')}.csv"
            filepath = os.path.join(LOG_DIR, filename)
            file_exists = os.path.isfile(filepath)

            with open(filepath, mode="a", newline="", encoding="utf-8") as f:
                writer = csv.writer(f)
                if not file_exists:
                    writer.writerow(["timestamp", "device_name", "latitude", "longitude", "battery", "accuracy"])

                for device in api.devices:
                    name = device.get("name")
                    battery = device.get("batteryLevel")
                    loc = device.location()
                    
                    if loc:
                        writer.writerow([
                            datetime.now().isoformat(),
                            name,
                            loc["latitude"],
                            loc["longitude"],
                            round(battery * 100) if battery else "N/A",
                            loc.get("accuracy", 0)
                        ])
            time.sleep(POLL_INTERVAL_SEC)

    except PyiCloudAPIResponseException as e:
        THREAD_STATUS["active"] = False
        THREAD_STATUS["error"] = f"Apple API Session Error: {e}"
    except Exception as e:
        THREAD_STATUS["active"] = False
        THREAD_STATUS["error"] = f"Logger Error: {e}"

