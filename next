st.title("📍 Find My Movement Dashboard")

@st.cache_data(ttl=15)
def load_all_logs():
    files = glob.glob(os.path.join(LOG_DIR, "locations_*.csv"))
    if not files:
        return pd.DataFrame()
    
    df_list = []
    for filepath in files:
        try:
            df_list.append(pd.read_csv(filepath))
        except Exception:
            continue
            
    if not df_list:
        return pd.DataFrame()

    full_df = pd.concat(df_list, ignore_index=True)
    full_df["timestamp"] = pd.to_datetime(full_df["timestamp"])
    return full_df

df = load_all_logs()

if df.empty:
    st.warning("No location logs found yet. Connect your Apple ID in the sidebar to start logging data.")
    st.stop()

# --- Sidebar Filters ---
st.sidebar.divider()
st.sidebar.header("Filter Options")

unit_system = st.sidebar.radio("Units", options=["Metric (km, km/h)", "Imperial (mi, mph)"])

# 1. Device Filter
devices = sorted(df["device_name"].dropna().unique().tolist())
selected_device = st.sidebar.selectbox("Select Person / Device", options=devices)

# 2. Date Filter
df["date"] = df["timestamp"].dt.date
available_dates = sorted(df["date"].unique(), reverse=True)
selected_date = st.sidebar.date_input("Select Date", value=available_dates[0])

# Slice dataset by device & date
filtered_df = df[
    (df["device_name"] == selected_device) & 
    (df["date"] == selected_date)
].sort_values("timestamp")

if filtered_df.empty:
    st.info("No location points recorded for this device on the selected date.")
    st.stop()

# 3. Timeline Slider
min_time = filtered_df["timestamp"].min().time()
max_time = filtered_df["timestamp"].max().time()

time_range = st.sidebar.slider(
    "Timeline Window",
    value=(min_time, max_time),
    format="HH:mm"
)

# Filter by time window
raw_timeline = filtered_df[
    (filtered_df["timestamp"].dt.time >= time_range[0]) & 
    (filtered_df["timestamp"].dt.time <= time_range[1])
]

# Filter GPS drift
cleaned_timeline = clean_gps_data(raw_timeline)

# --- STATS SUMMARY BAR ---
stats = calculate_trip_stats(cleaned_timeline)

col1, col2, col3, col4 = st.columns(4)
if "Metric" in unit_system:
    col1.metric("Distance Traveled", f"{stats['dist_km']:.2f} km")
    col2.metric("Avg Speed", f"{stats['avg_speed_kmh']:.1f} km/h")
else:
    col1.metric("Distance Traveled", f"{stats['dist_mi']:.2f} mi")
    col2.metric("Avg Speed", f"{stats['avg_speed_mph']:.1f} mph")

col3.metric("Duration", f"{stats['duration_min']} mins")
col4.metric("Valid GPS Points", f"{len(cleaned_timeline)}")

st.divider()

# --- MAIN MAP & TABLE LAYOUT ---
col_map, col_table = st.columns([2, 1])

with col_map:
    st.subheader(f"Route Map: {selected_device}")
    
    if not cleaned_timeline.empty:
        path_df = cleaned_timeline.sort_values("timestamp").copy()
        coords = path_df[["longitude", "latitude"]].values.tolist()
        
        # 1. Connected Path Line (Blue)
        layer_path = pdk.Layer(
            "PathLayer",
            data=[{"path": coords}],
            get_path="path",
            get_color="[50, 150, 250, 220]",
            width_min_pixels=3,
        )

        # 2. Intermediate Waypoints (Translucent Blue)
        middle_points = path_df.iloc[1:-1] if len(path_df) > 2 else pd.DataFrame()
        layers = [layer_path]
        
        if not middle_points.empty:
            layers.append(pdk.Layer(
                "ScatterplotLayer",
                data=middle_points,
                get_position=["longitude", "latitude"],
                get_color="[100, 100, 250, 160]",
                get_radius=20,
                radius_min_pixels=3,
                pickable=True,
            ))

        # 3. Start Point (Green)
        layers.append(pdk.Layer(
            "ScatterplotLayer",
            data=path_df.iloc[[0]],
            get_position=["longitude", "latitude"],
            get_color="[40, 200, 40, 255]",
            get_radius=50,
            radius_min_pixels=7,
            pickable=True,
        ))

        # 4. End / Current Point (Red)
        layers.append(pdk.Layer(
            "ScatterplotLayer",
            data=path_df.iloc[[-1]],
            get_position=["longitude", "latitude"],
            get_color="[230, 40, 40, 255]",
            get_radius=60,
            radius_min_pixels=9,
            pickable=True,
        ))

        st.pydeck_chart(pdk.Deck(
            layers=layers,
            initial_view_state=pdk.ViewState(
                latitude=path_df["latitude"].mean(),
                longitude=path_df["longitude"].mean(),
                zoom=14,
                pitch=0
            ),
            map_style="mapbox://styles/mapbox/light-v10",
            tooltip={"text": "Time: {timestamp}\nBattery: {battery}%\nAccuracy: {accuracy}m"}
        ))
    else:
        st.write("No location data available in this time slice.")

with col_table:
    st.subheader("Location Log")
    display_df = cleaned_timeline[["timestamp", "battery", "latitude", "longitude"]].copy()
    display_df["timestamp"] = display_df["timestamp"].dt.strftime("%H:%M:%S")
    st.dataframe(display_df, use_container_width=True, hide_index=True)
