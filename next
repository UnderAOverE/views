import sys

sys.dont_write_bytecode = True

# External imports

from datetime import datetime
from typing import Any

import polars as pl
import streamlit as st

# Internal imports

from core.config.sre_business_transactions import (
    SreBtCatalog,
    load_sre_business_transactions_settings,
)
from core.config.sre_metrics import load_sre_metrics_settings
from core.constants import UTC
from dashboards.data import get_runtime
from sre.business_transactions import BusinessTransactionsRepository

# Local variables

#: Hard upper-bound TTL on cached catalog calls. Catalog edits are rare on the
#: SRE side, so a generous TTL keeps page load fast.
_CACHE_HARD_TTL_S: int = 1800

#: Floor "now" to this many seconds when building the cache-key bucket so the
#: catalog refresh fires on stable boundaries instead of every page render.
_CATALOG_BUCKET_S: int = 300

#: Columns rendered in the BT table, in display order. The page model maps
#: from the wire-format aliases to these snake_case attribute names.
_DISPLAY_COLUMNS: list[str] = [
    "active",
    "sector",
    "environment",
    "appname",
    "databasename",
    "collectionname",
    "querytool",
    "batch_name",
    "interval",
    "csi",
    "lob",
    "business",
    "onboardinguser",
    "last_updated_by",
    "last_updated_on",
]


# ----------------------------------------------------------------------------------------------------#
# Cached query helpers.                                                                               #
# ----------------------------------------------------------------------------------------------------#

def _now_bucket_iso(now_utc: datetime, ttl_seconds: int) -> str:

    """
    Floor `now_utc` to a TTL-window-aligned ISO string used as a cache key.

    :param now_utc: reference "now".
    :type now_utc: datetime
    :param ttl_seconds: window size.
    :type ttl_seconds: int
    :return: ISO-format string of the floored timestamp.
    :rtype: str
    """

    floor = datetime.fromtimestamp(
        int(now_utc.timestamp()) // max(ttl_seconds, 1) * max(ttl_seconds, 1),
        tz=UTC,
    )
    return floor.isoformat()

# endDef


@st.cache_data(ttl=_CACHE_HARD_TTL_S, show_spinner="Loading catalog…")
def _list_catalog_cached(
        database: str,
        collection: str,
        now_bucket: str,
) -> list[dict[str, Any]]:

    """
    Cached wrapper around `BusinessTransactionsRepository.list_all`.

    Returns dicts (model_dump) so the result is JSON-serializable and
    survives Streamlit's cache hashing. Aliased field names are preserved on
    the dump so the page can choose between the snake_case attribute names
    (default columns) and the wire-format names (raw-doc viewer).

    :param database: target Mongo database.
    :type database: str
    :param collection: target Mongo collection.
    :type collection: str
    :param now_bucket: floor-aligned cache key.
    :type now_bucket: str
    :return: list of catalog dicts.
    :rtype: list[dict[str, Any]]
    """

    adapter = get_runtime().adapter
    repo = BusinessTransactionsRepository(adapter, database, collection)
    return [row.model_dump() for row in repo.list_all()]

# endDef


@st.cache_data(ttl=_CACHE_HARD_TTL_S, show_spinner=False)
def _distinct_field_cached(
        database: str,
        collection: str,
        field: str,
        now_bucket: str,
) -> list[str]:

    """
    Cached wrapper around `BusinessTransactionsRepository.distinct_field`.

    :param database: target Mongo database.
    :type database: str
    :param collection: target Mongo collection.
    :type collection: str
    :param field: dotted field path to enumerate.
    :type field: str
    :param now_bucket: floor-aligned cache key.
    :type now_bucket: str
    :return: distinct values.
    :rtype: list[str]
    """

    adapter = get_runtime().adapter
    repo = BusinessTransactionsRepository(adapter, database, collection)
    return repo.distinct_field(field)

# endDef


# ----------------------------------------------------------------------------------------------------#
# Page.                                                                                               #
# ----------------------------------------------------------------------------------------------------#

st.set_page_config(
    page_title="SRE Business Transactions - AMP Analytics Platform",
    layout="wide",
)
st.title("SRE Business Transactions")
st.caption(
    "Catalog of every onboarded business transaction. Each row tells you which "
    "(database, collection) the live SREData lives in, who onboarded it, and who "
    "last edited it. Use this to answer 'is this BT actually being scraped?' and "
    "'who do I ask about this BT?' before drilling into the SRE Metrics page."
)

settings = load_sre_business_transactions_settings()

if not settings.catalogs:
    st.info(
        "`conf/sre_business_transactions.yaml` declares no catalogs. Add a "
        "`catalogs:` list with at least one `{name, display_name, database, "
        "collection}` entry to populate this page."
    )
    st.stop()

# endIf


# ----------------------------------------------------------------------------------------------------#
# Refresh + sidebar.                                                                                  #
# ----------------------------------------------------------------------------------------------------#

ref_col, ts_col = st.columns([1, 6])
with ref_col:
    if st.button(
        "Refresh",
        key="sre_bt_refresh",
        help="Re-fetch the catalog from Mongo and rebuild every dropdown.",
    ):
        _list_catalog_cached.clear()           # type: ignore[attr-defined]
        _distinct_field_cached.clear()         # type: ignore[attr-defined]
        st.rerun()

    # endIf

# endWith

with ts_col:
    st.caption(f"Loaded at: {datetime.now(UTC).isoformat(timespec='seconds')}")

# endWith

st.sidebar.subheader("Catalog source")

catalog_labels: dict[str, SreBtCatalog] = {
    f"{c.display_name} ({c.database}.{c.collection})": c for c in settings.catalogs
}
picked_label = st.sidebar.selectbox(
    "Catalog",
    options=list(catalog_labels.keys()),
    index=0,
    key="sre_bt_catalog",
)
catalog = catalog_labels[picked_label]

now_utc = datetime.now(UTC)
now_bucket = _now_bucket_iso(now_utc, _CATALOG_BUCKET_S)


# ----------------------------------------------------------------------------------------------------#
# Sidebar filters.                                                                                    #
# ----------------------------------------------------------------------------------------------------#

st.sidebar.markdown("---")
st.sidebar.subheader("Filters")

sectors = _distinct_field_cached(catalog.database, catalog.collection, "sector", now_bucket)
environments = _distinct_field_cached(catalog.database, catalog.collection, "environment", now_bucket)
querytools = _distinct_field_cached(catalog.database, catalog.collection, "querytool", now_bucket)

picked_sectors: list[str] = st.sidebar.multiselect(
    "Sector",
    options=sectors,
    default=[],
    key="sre_bt_sectors",
    help="Empty = include all sectors.",
)

picked_envs: list[str] = st.sidebar.multiselect(
    "Environment",
    options=environments,
    default=[],
    key="sre_bt_envs",
    help="Empty = include all environments.",
)

picked_tools: list[str] = st.sidebar.multiselect(
    "Query tool",
    options=querytools,
    default=[],
    key="sre_bt_tools",
    help="Empty = include every querytool (Splunk / AppD / ELK / …).",
)

active_filter: str = st.sidebar.radio(
    "Active flag",
    options=["Any", "Active only", "Inactive only"],
    index=0,
    key="sre_bt_active",
)

# FCA filter: a BT counts as FCA when ANY of its `features` is in the
# `fca_features` list maintained alongside the SRE Metrics page in
# `conf/sre_metrics.yaml`. Shared list across pages so the operator only
# curates the FCA set in one place.
fca_features_yaml: tuple[str, ...] = tuple(load_sre_metrics_settings().fca_features)

if fca_features_yaml:
    fca_only = st.sidebar.toggle(
        "FCA only",
        value=False,
        key="sre_bt_fca_only",
        help=(
            f"When ON, the catalog is filtered to BTs whose `features` overlap "
            f"the {len(fca_features_yaml)} Franchise Critical Application(s) listed "
            "under `fca_features` in `conf/sre_metrics.yaml`."
        ),
    )

else:
    st.sidebar.toggle(
        "FCA only",
        value=False,
        disabled=True,
        key="sre_bt_fca_only_disabled",
        help="`fca_features` is empty in `conf/sre_metrics.yaml` - nothing to filter to.",
    )
    fca_only = False

# endIfElse


# ----------------------------------------------------------------------------------------------------#
# Body.                                                                                               #
# ----------------------------------------------------------------------------------------------------#

rows: list[dict[str, Any]] = _list_catalog_cached(
    catalog.database, catalog.collection, now_bucket,
)

if not rows:
    st.warning(
        f"No documents in `{catalog.database}.{catalog.collection}`. Either the "
        "catalog is empty or the namespace is misconfigured."
    )
    st.stop()

# endIf


def _matches_fca(items: Any, fca_set: set[str]) -> bool:

    """
    True when any feature in `items` matches the FCA set by id or name.

    The BT catalog's `features` field is producer-permissive: each item is
    either a plain string (programmatic id) or a dict carrying `id` and
    `name` keys plus producer-specific extras. We check both keys so
    whichever convention the catalog uses still hits the FCA set.

    :param items: row['features'] value - typically a list of strings or
        a list of dicts; tolerant of None / scalar surprises.
    :type items: Any
    :param fca_set: pre-computed set of FCA Feature ids for fast lookup.
    :type fca_set: set[str]
    :return: True if any item matches; False otherwise.
    :rtype: bool
    """

    if not items or not isinstance(items, list):
        return False

    # endIf

    for item in items:
        if isinstance(item, str):
            if item in fca_set:
                return True

            # endIf

        elif isinstance(item, dict):
            if item.get("id") in fca_set or item.get("name") in fca_set:
                return True

            # endIf

        # endIfElif

    # endFor

    return False

# endDef


# All filtering happens on the raw Python list of dicts, NOT through polars.
# Reason: BT catalog rows carry heterogeneous nested fields (`features` is
# list-of-dict with variable keys; `mongoDetails` is sometimes `{}` and
# sometimes populated; `datacenters` is sometimes a list and sometimes
# absent). Building a polars DataFrame from the raw rows trips polars'
# struct-schema inference - it can't reconcile `mongoDetails: {}` with
# `mongoDetails: {"some": "key"}`. We sidestep that entirely by only handing
# polars a flat projection of scalar display columns AFTER all filters run.
fca_set: set[str] = set(fca_features_yaml)

filtered_rows: list[dict[str, Any]] = []
for row in rows:
    if picked_sectors and row.get("sector") not in picked_sectors:
        continue

    # endIf

    if picked_envs and row.get("environment") not in picked_envs:
        continue

    # endIf

    if picked_tools and row.get("querytool") not in picked_tools:
        continue

    # endIf

    active_value = row.get("active")
    if active_filter == "Active only" and active_value is not True:
        continue

    # endIf

    if active_filter == "Inactive only" and active_value is True:
        continue

    # endIf

    if fca_only and fca_set and not _matches_fca(row.get("features"), fca_set):
        continue

    # endIf

    filtered_rows.append(row)

# endFor


# ---- Summary metric cards --------------------------------------------------

total = len(filtered_rows)
active_count = sum(1 for r in filtered_rows if r.get("active") is True)
inactive_count = total - active_count
distinct_apps = len({r.get("appname") for r in filtered_rows if r.get("appname")})
distinct_users = len({r.get("onboardinguser") for r in filtered_rows if r.get("onboardinguser")})

c1, c2, c3, c4, c5 = st.columns(5)
c1.metric("Total BTs", f"{total:,}")
c2.metric("Active", f"{active_count:,}")
c3.metric("Inactive", f"{inactive_count:,}")
c4.metric("Distinct apps", f"{distinct_apps:,}")
c5.metric("Distinct onboarders", f"{distinct_users:,}")


# ---- Catalog table ---------------------------------------------------------

st.markdown("---")
st.subheader("Catalog")
st.caption(
    "Sortable / scrollable table of every catalog row matching the sidebar filters. "
    "Click a column header to sort. Use the 'Raw doc' expander below to inspect "
    "the full document for any BT."
)

if not filtered_rows:
    st.info("No rows match the selected filters.")

else:
    # Flat projection: ONLY the scalar display columns. Nested / list fields
    # (`features`, `datacenters`, `mongoDetails`, etc.) are deliberately
    # excluded so polars never sees them and never has to infer a struct
    # schema across rows.
    display_rows = [
        {col: r.get(col) for col in _DISPLAY_COLUMNS}
        for r in filtered_rows
    ]
    display_df = pl.DataFrame(display_rows, strict=False)
    st.dataframe(display_df, width="stretch", hide_index=True)

# endIfElse


# ---- Raw doc viewer --------------------------------------------------------

st.markdown("---")
st.subheader("Raw doc")
st.caption(
    "Pick an appname to inspect the full BT config - useful when you need to "
    "see fields not in the table above (features / datacenters / lifecycle metadata)."
)

if filtered_rows:
    app_options = sorted({
        str(r["appname"]) for r in filtered_rows if r.get("appname")
    })

    if app_options:
        picked_app = st.selectbox(
            "Appname",
            options=app_options,
            index=0,
            key="sre_bt_raw_app",
        )

        match_rows = [r for r in filtered_rows if str(r.get("appname") or "") == picked_app]
        for idx, row in enumerate(match_rows):
            with st.expander(
                f"{row.get('databasename', '?')}.{row.get('collectionname', '?')} ({picked_app})",
                expanded=(idx == 0 and len(match_rows) == 1),
            ):
                st.json(row, expanded=False)

            # endWith

        # endFor

    else:
        st.info("No `appname` field on the filtered rows - skipping raw-doc viewer.")

    # endIfElse

else:
    st.info("No rows to inspect.")

# endIfElse


