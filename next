import sys

sys.dont_write_bytecode = True

# External imports

from collections.abc import Mapping
from typing import Any

from pydantic import BaseModel, ConfigDict, Field

# Internal imports

from core.db.adapters import PyMongoAdapter

# Local variables

# (none)


# ----------------------------------------------------------------------------------------------------#
# Model.                                                                                              #
# ----------------------------------------------------------------------------------------------------#

class BusinessTransactionConfig(BaseModel):

    """
    One row in the BusinessTransactions catalog. Wire format is mixed
    PascalCase (`Business`, `Drift_AppName`, `TechnologyManagedSegment_L6`)
    and lowercase (`databasename`, `lastUpdatedBy`, `onboardinguser`); we
    keep both via Pydantic aliases without forcing a global rename.

    `extra="allow"` because the upstream producer adds fields opportunistically
    (the sample doc carries ~30 fields and operators have signalled more on
    the way). We expose the operationally-useful subset as typed attributes;
    the rest stays accessible via `model_dump(by_alias=True)` for raw access.

    `lastUpdatedOn` is a non-ISO string ("10/8/2025 16:12 EST"); kept as a
    string and parsed only on the display layer where best-effort is fine.
    """

    model_config = ConfigDict(populate_by_name=True, extra="allow")

    # ---- Catalog target (where the live SREData lives) ---- #

    databasename: str | None = Field(default=None, description="DB hosting the SREData for this BT.")
    collectionname: str | None = Field(default=None, description="Collection hosting the SREData for this BT.")
    fetchcollectionname: str | None = Field(
        default=None,
        description="Companion fetch collection name (producer-side detail).",
    )

    # ---- Org metadata ---- #

    sector: str | None = Field(default=None, description="Sector rollup (e.g. PBWM).")
    region: str | None = Field(default=None, description="Region (e.g. NAM).")
    environment: str | None = Field(default=None, description="Environment (e.g. PRODUCTION).")
    lob: str | None = Field(default=None, description="Line of business.")
    appname: str | None = Field(default=None, description="Owning application name.")
    csi: str | None = Field(default=None, description="CSI number.")
    business: str | None = Field(
        default=None,
        alias="Business",
        description="Business unit (USPB, etc.) - aliased from PascalCase wire name.",
    )

    # ---- Producer / batch config ---- #

    querytool: str | None = Field(default=None, description="Tool the BT is queried via (Splunk, AppD, ELK, …).")
    batch_name: str | None = Field(
        default=None,
        alias="batchName",
        description="Producer batch identifier.",
    )
    interval: int | None = Field(default=None, description="Producer cadence in seconds.")
    active: bool | None = Field(default=None, description="Whether the BT is currently being scraped.")
    features: list[Any] = Field(
        default_factory=list,
        description=(
            "Features emitted by this BT. Producer-side schema is permissive - some "
            "catalogs store this as a list of plain feature-name strings, others as "
            "a list of dicts (each carrying a name + extra metadata). Typed `list[Any]` "
            "so both shapes parse; the page normalizes when extracting names for the "
            "FCA filter / display."
        ),
    )
    datacenters: list[str] = Field(default_factory=list, description="Datacenters in scope for this BT.")

    # ---- Lifecycle metadata (the user-visible 'who/when' columns) ---- #

    onboardinguser: str | None = Field(default=None, description="SOEID of the operator who onboarded the BT.")
    onboardingtool: str | None = Field(
        default=None,
        description="UA / tool string captured at onboard time.",
    )
    last_updated_by: str | None = Field(
        default=None,
        alias="lastUpdatedBy",
        description="SOEID of the last operator to edit this catalog row.",
    )
    last_updated_on: str | None = Field(
        default=None,
        alias="lastUpdatedOn",
        description="Free-form timestamp string (often 'MM/DD/YYYY HH:MM TZ').",
    )

    mongo_id: Any | None = Field(default=None, alias="_id", description="Mongo _id (ObjectId or string).")

# endClass


# ----------------------------------------------------------------------------------------------------#
# Repository.                                                                                         #
# ----------------------------------------------------------------------------------------------------#

class BusinessTransactionsRepository:

    """
    Sync read access to one sector's BusinessTransactions catalog.

    Not derived from BaseAuditRepository - this is registry-style metadata,
    not audit telemetry. Kept under `src/sre/` because the catalog is the
    SRE team's source of truth for which BTs to monitor.
    """

    def __init__(
            self,
            adapter: PyMongoAdapter,
            database: str,
            collection: str,
    ) -> None:

        """
        Bind to one (database, collection) namespace.

        :param adapter: shared sync PyMongoAdapter from AppRuntime.
        :type adapter: PyMongoAdapter
        :param database: Mongo database name (e.g. "PBWM").
        :type database: str
        :param collection: Mongo collection name (typically "BusinessTransactions").
        :type collection: str
        """

        self._adapter = adapter
        self._database = database
        self._collection = collection

    # endDef

    @property
    def database(self) -> str:

        """Database name this repository targets."""

        return self._database

    # endDef

    @property
    def collection(self) -> str:

        """Collection name this repository targets."""

        return self._collection

    # endDef

    def list_all(
            self,
            *,
            limit: int = 5000,
            extra_filter: Mapping[str, Any] | None = None,
    ) -> list[BusinessTransactionConfig]:

        """
        Fetch the full catalog (or a filtered subset) as parsed config rows.

        Sorted by `lastUpdatedOn` desc - most-recently-edited rows surface
        first. The sort uses the string value as-is; given the non-ISO format
        on the source side that's a best-effort ordering, but it's good
        enough for "operators are usually looking at what just changed."

        :param limit: hard cap on rows returned; must be positive.
        :type limit: int
        :param extra_filter: optional Mongo filter to narrow the catalog.
        :type extra_filter: Mapping[str, Any] | None
        :return: parsed config rows.
        :rtype: list[BusinessTransactionConfig]
        :raises ValueError: when limit is not positive.
        """

        if limit <= 0:
            raise ValueError("limit must be positive")

        # endIf

        query: dict[str, Any] = dict(extra_filter) if extra_filter else {}
        cursor = self._adapter.find(
            self._database,
            self._collection,
            query=query,
            sort=[("lastUpdatedOn", -1)],
            limit=limit,
        )
        return [BusinessTransactionConfig.model_validate(doc) for doc in cursor]

    # endDef

    def distinct_field(self, field: str) -> list[str]:

        """
        Distinct values for a single field across the catalog. Used to
        populate sidebar dropdowns (sector / environment / querytool / …).

        :param field: dotted field path on the catalog doc.
        :type field: str
        :return: sorted, deduplicated, None-dropped, str-cast list of values.
        :rtype: list[str]
        """

        values = self._adapter.distinct(self._database, self._collection, field)
        return sorted({str(v) for v in values if v is not None})

    # endDef

# endClass


