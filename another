import asyncio

async def flatten_clusters_by_namespace(clusters: list[dict]) -> list[dict]:
    """
    Asynchronously flattens a list of clusters, replicating cluster information
    for each namespace within the 'namespaces' list.

    Args:
        clusters: A list of dictionaries, where each dictionary represents a cluster
                  and contains a 'namespaces' key (list[str]).

    Returns:
        A new list of dictionaries, where each original cluster entry is replicated
        for each of its namespaces, with 'namespace' as a new key.
    """
    flattened_list = []

    async def process_single_cluster(cluster_data):
        cluster_name = cluster_data.get("name")
        account_id = cluster_data.get("account_id")
        region = cluster_data.get("region")
        environment = cluster_data.get("environment")
        namespaces = cluster_data.get("namespaces", [])

        if not namespaces:
            # If no namespaces, just add the cluster data without a namespace key
            # or handle as per specific requirement (e.g., skip it)
            new_entry = {
                "name": cluster_name,
                "account_id": account_id,
                "region": region,
                "environment": environment,
                "namespace": None # Or remove this key if no namespace is desired
            }
            return [new_entry]

        # Create a list of new entries for each namespace
        namespace_entries = []
        for namespace in namespaces:
            new_entry = {
                "name": cluster_name,
                "account_id": account_id,
                "region": region,
                "environment": environment,
                "namespace": namespace,
            }
            namespace_entries.append(new_entry)
        return namespace_entries

    # Create a list of tasks for processing each cluster concurrently
    tasks = [process_single_cluster(cluster) for cluster in clusters]
    
    # Gather all results. Each result from process_single_cluster is a list of dictionaries.
    results = await asyncio.gather(*tasks)

    # Flatten the list of lists into a single list
    for sublist in results:
        flattened_list.extend(sublist)

    return flattened_list

# Example Usage:
async def main():
    clusters_data = [
        {
            "name": "cluster-1",
            "account_id": "123",
            "region": "us-east-1",
            "environment": "dev",
            "namespaces": ["ns-a", "ns-b", "ns-c"],
        },
        {
            "name": "cluster-2",
            "account_id": "456",
            "region": "us-west-2",
            "environment": "prod",
            "namespaces": ["ns-x", "ns-y"],
        },
        {
            "name": "cluster-3",
            "account_id": "789",
            "region": "eu-central-1",
            "environment": "test",
            "namespaces": [], # Cluster with no namespaces
        },
        {
            "name": "cluster-4",
            "account_id": "101",
            "region": "ap-south-1",
            "environment": "dev",
            "namespaces": ["ns-p"],
        },
    ]

    print("--- Original Clusters ---")
    for cluster in clusters_data:
        print(cluster)
    print("\n")

    print("--- Flattened Clusters ---")
    flattened_clusters = await flatten_clusters_by_namespace(clusters_data)
    for entry in flattened_clusters:
        print(entry)
    print("\n")

if __name__ == "__main__":
    asyncio.run(main())
