def check_serial_mismatch(records: list[dict], dn_to_check: str, serial_number_to_check: str) -> bool | None:
    """
    Filters records by distinguished_name, finds the latest by log_datetime,
    and checks whether its serial_number mismatches the provided one.

    Returns:
        True  — latest record's serial_number does NOT match (mismatch detected)
        False — latest record's serial_number matches
        None  — no records found for the given distinguished_name
    """
    matches = [r for r in records if r["distinguished_name"] == dn_to_check]

    if not matches:
        return None

    latest = max(matches, key=lambda r: r["log_datetime"])

    return latest["serial_number"] != serial_number_to_check



result = check_serial_mismatch(records, dn_to_check="dn1", serial_number_to_check="afwer")

if result is None:
    print("No records found for that distinguished name.")
elif result:
    print("Mismatch detected — serial number has changed.")
else:
    print("Serial number matches the latest record.")
