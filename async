# ── SplunkFeed ────────────────────────────────────────────────────────────────

SPLUNK_FEED_INDEXES: list[IndexModel] = [
    # Primary query index — covers the exact filter pattern used in the query.
    # Field order follows ESR rule (Equality → Sort/Range):
    #   source_type (eq) → cluster (eq) → project (eq) → service_name (eq)
    #   → log_datetime (range) → distinguished_name is a regex so goes last.
    # Note: regex ($regex) fields benefit from an index prefix but cannot be
    # fully covered — placing it last minimises the scan after the eq fields.
    IndexModel(
        keys=[
            ("source_type", ASCENDING),
            ("cluster", ASCENDING),
            ("project", ASCENDING),
            ("service_name", ASCENDING),
            ("log_datetime", ASCENDING),
            ("distinguished_name", ASCENDING),
        ],
        name="idx_splunkfeed_query",
        background=True,
    ),
    # TTL index — documents auto-deleted 1 year (365 days) after log_datetime.
    # expireAfterSeconds = 365 * 24 * 60 * 60 = 31,536,000
    IndexModel(
        keys=[("log_datetime", ASCENDING)],
        name="idx_splunkfeed_log_datetime_ttl",
        expireAfterSeconds=31_536_000,
        background=True,
    ),
]


await _create_indexes_for_collection(
    db,
    "SplunkFeed",
    SPLUNK_FEED_INDEXES,
)
