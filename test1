</body></html>
""" % {
        "subject": e(c.get("subject", "")), "badge": badge, "verdict": d["verdict"],
        "run_at": e(d["run_at"]), "run_at_local": e(d["run_at_local"]), "duration": d["duration_ms"], "run_from": e(d["run_from"]),
